---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bookingHref } from '../../config/site';
---
<BaseLayout title="Your guide is on its way" description="Thanks for requesting the Ultimate Blueprint for Fat Loss from Aquam Fitness." mood="coaching">
  <section class="section surface">
    <div class="wrap stack">
      <h1>Your guide is on its way</h1>
      <p class="lead">Check your inbox for the Ultimate Blueprint for Fat Loss. It covers calorie balance, protein and balanced nutrition, daily movement, recovery, and practical habits for sustainable progress.</p>
      <p>If you don't see it, check your spam or promotions folder.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={bookingHref('consult')}>Book a free consult</a>
        <a class="btn btn-ghost" href="/coaching/">Explore 1:1 coaching</a>
      </div>
    </div>
  </section>
</BaseLayout>
