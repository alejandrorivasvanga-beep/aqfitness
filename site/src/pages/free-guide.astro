---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import HubSpotForm from '../components/HubSpotForm.astro';
---
<BaseLayout
  title="Ultimate Blueprint for Fat Loss"
  description="Get Aquam Fitness's Ultimate Blueprint for Fat Loss: practical strategies to lose fat, build better habits and make progress without restrictive diets."
  mood="coaching"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Ultimate Blueprint for Fat Loss', path: '/free-guide/' }]}
>
  <PageHero
    mood="coaching"
    title="Get the Ultimate Blueprint for Fat Loss"
    lead="Practical strategies to help you lose fat, build better habits and get results without restrictive diets or spending your life in the gym."
  >
    <div slot="aside" class="guide-form">
      <h2>Send me the free blueprint</h2>
      <HubSpotForm id="free-guide-signup" />
      <p class="small muted">You'll also get occasional training and nutrition tips. Unsubscribe any time.</p>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap inside">
      <h2>What's inside</h2>
      <p><Placeholder label="guide contents, to be written by Alejandro" /></p>
      <ul>
        <li>Practical fat-loss strategies you can use right away</li>
        <li>How to build sustainable nutrition habits</li>
        <li>Ways to stay consistent without restrictive diets</li>
        <li>How to make progress while living your real life</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-form { display: grid; gap: 16px; background: var(--white); border-radius: var(--radius); padding: clamp(20px, 3vw, 32px); }
  .guide-form h2 { font-size: var(--fs-h3); margin: 0; }
  .guide-form p { margin: 0; }
  .inside { max-width: 760px; }
  .inside ul { color: var(--text); }
  .inside li + li { margin-top: 8px; }
  .inside li::marker { color: var(--accent-ink); }
</style>
